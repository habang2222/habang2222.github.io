<Window x:Class="EveRemote.Controller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EVE Remote Manager" Height="650" Width="1100"
        MinHeight="480" MinWidth="800" Background="#10141A" Foreground="#EDF2F7">
    <Grid Margin="16">
        <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#19212B" CornerRadius="8" Padding="14">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="연결된 컴퓨터" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <ListBox ItemsSource="{Binding Agents}" SelectedItem="{Binding SelectedAgent}"
                         Background="Transparent" BorderThickness="0" Foreground="White">
                    <ListBox.ItemTemplate><DataTemplate>
                        <Border Padding="10" Margin="0,0,0,6" Background="#24303D" CornerRadius="6">
                            <StackPanel>
                                <TextBlock Text="{Binding MachineName}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Endpoint}" Foreground="#94A3B8" FontSize="12"/>
                                <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}"/>
                                <TextBlock Text="{Binding ClientCountText}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
        <Border Grid.Column="2" Background="#19212B" CornerRadius="8" Padding="14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Text="EVE 창" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="1단계: 창 상태만 표시합니다. 영상과 입력은 아직 비활성화되어 있습니다." Foreground="#94A3B8"/>
                </StackPanel>
                <ListView ItemsSource="{Binding SelectedAgent.Clients}" Background="Transparent" Foreground="White" BorderThickness="0">
                    <ListView.View><GridView>
                        <GridViewColumn Header="창 제목" DisplayMemberBinding="{Binding WindowTitle}" Width="330"/>
                        <GridViewColumn Header="PID" DisplayMemberBinding="{Binding ProcessId}" Width="80"/>
                        <GridViewColumn Header="해상도" DisplayMemberBinding="{Binding Resolution}" Width="120"/>
                        <GridViewColumn Header="상태" DisplayMemberBinding="{Binding State}" Width="100"/>
                    </GridView></ListView.View>
                </ListView>
            </DockPanel>
        </Border>
    </Grid>
</Window>
